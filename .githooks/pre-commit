#!/bin/sh

echo "��� Running pre-commit safety checks..."

echo "��� Checking Rust formatting..."
cargo fmt --all -- --check
if [ $? -ne 0 ]; then
    echo "❌ cargo fmt failed! Run 'cargo fmt --all' to fix formatting."
    exit 1
fi

echo "��� Running Clippy..."
cargo clippy --workspace -- -D warnings
if [ $? -ne 0 ]; then
    echo "❌ Clippy found errors! Fix warnings before committing."
    exit 1
fi

echo "��� Running Cargo tests..."
cargo test --workspace
if [ $? -ne 0 ]; then
    echo "❌ Tests failed! Fix falling tests before committing."
    exit 1
fi

echo "✅ All checks passed successfully!"
exit 0
